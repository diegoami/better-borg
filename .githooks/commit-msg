#!/bin/sh
# Mandos's commit-msg: runs the engine checkout's own hook (the privacy scan and the
# no-AI-trailer check, RULES.md). Upstream stores its hooks without
# the executable bit (100644), so pointing core.hooksPath straight at them
# runs nothing on Linux; this executable wrapper calls them with sh instead,
# and keeps the engine checkout untouched. Setup: docs/process.md.
TOP=$(git rev-parse --show-toplevel)
if [ -n "${NEO_ANGBAND_REPO:-}" ]; then
  ENGINE=$NEO_ANGBAND_REPO
elif [ -d "$TOP/../neo-angband-tracker/.githooks" ]; then
  ENGINE=$TOP/../neo-angband-tracker
else
  ENGINE=$TOP/../neo-angband
fi
HOOK="$ENGINE/.githooks/commit-msg"
if [ ! -f "$HOOK" ]; then
  echo "commit-msg: no engine checkout hook at $HOOK (set NEO_ANGBAND_REPO or clone ../neo-angband-tracker)" >&2
  exit 1
fi
exec sh "$HOOK" "$@"
